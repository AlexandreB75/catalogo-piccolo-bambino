# Chave da Anthropic — nunca exposta no frontend
ANTHROPIC_API_KEY=sk-ant-...

# Managed Agent ID — gerado automaticamente por: node setup-agents.js
# Não preencha manualmente, o script cria e salva aqui
LOTUS_AGENT_ID=

# Porta do servidor Express (proxy)
PORT=3001

# Ambiente (development | production)
NODE_ENV=development
